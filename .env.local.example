GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

MICROSOFT_CLIENT_ID=your-azure-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Postgres (Prisma) — the single database for everything: work_sessions,
# send_jobs, send_recipients, campaigns, campaign_recipients,
# campaign_attachments, files_handler (attachment chunks), and send_tokens
# (live Gmail/Outlook OAuth tokens). See prisma/schema.prisma.
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct (non-pooled) connection, used only by the Prisma CLI
# (migrate/introspect/studio) — a pooler doesn't support the session-level
# advisory lock migrations need. On Prisma Postgres these share the same
# credentials; DIRECT_URL just swaps `pooled.db.prisma.io` for `db.prisma.io`.
DATABASE_URL=postgresql://user:password@pooled-host:5432/dbname
DIRECT_URL=postgresql://user:password@direct-host:5432/dbname

# Random secret for Vercel Cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
