GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

MICROSOFT_CLIENT_ID=your-azure-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Turso (libSQL) — from Turso dashboard → your database → Connect
# ONLY send_tokens lives here now: live Gmail/Outlook OAuth tokens
# (deliberately kept out of the Sheet). Everything else — work_sessions,
# send_jobs, send_recipients, campaigns, campaign_recipients,
# campaign_attachments, and files_handler (attachment chunks) — lives in
# Google Sheets — see GOOGLE_SHEETS_* below.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Google Sheets — live database for everything except OAuth tokens above.
# Service Account (separate from the GOOGLE_CLIENT_ID/SECRET OAuth app above).
# 1. Enable Google Sheets API in a GCP project, create a Service Account, download its JSON key
# 2. Share the target Sheet with the Service Account's email (Editor access)
# Tabs are auto-created on first use (including files_handler for attachments).
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Random secret for Vercel Cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
